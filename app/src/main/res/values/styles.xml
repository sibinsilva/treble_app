<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.CustomTitle" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SwitchMonetStyle" parent="ThemeOverlay.Material3">
        <item name="colorControlActivated">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearance.CustomSummary" parent="TextAppearance.MaterialComponents.Body2">
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Android 16 Settings-style rows: one card per row, segmented into groups at runtime.
         Names avoid dots so they don't implicitly inherit TrebleRow's padding. -->
    <style name="TrebleRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">1dp</item>
    </style>

    <style name="TrebleRowCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:background">@drawable/bg_row_single</item>
    </style>

    <style name="TrebleRowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="TrebleRowTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.CustomTitle</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">3</item>
    </style>

    <style name="TrebleRowSummary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.CustomSummary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">10</item>
    </style>

    <style name="TrebleRowIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">?attr/colorPrimary</item>
    </style>

    <!-- Top-level entries: 24dp glyph inside a 40dp tonal circle -->
    <style name="TrebleRowIconBadge">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/bg_icon_badge</item>
        <item name="android:tint">?attr/colorOnSecondaryContainer</item>
    </style>
</resources>
